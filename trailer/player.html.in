<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="color-scheme" content="dark">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; media-src data:; img-src data:; font-src data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'none'; base-uri 'none'; form-action 'none'">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 38'%3E%3Cpath fill='%230e1921' stroke='%23f2c17b' stroke-width='2' d='m18 2 15 6v14L18 36 3 22V8z'/%3E%3Cpath fill='%23f2c17b' d='m9 12 9 4 9-4v4l-9 4-9-4zm0 8 9 4 9-4-9 9z'/%3E%3C/svg%3E">
<title>Двойной залп — трейлер CITY TANKS</title>
<style>
@font-face{font-family:Oswald;src:url('@FONT@') format('truetype');font-weight:200 700;font-display:swap}
:root{--bg:#091119;--panel:#111d26;--hair:#34444e;--ice:#edf3f3;--dim:#aebec7;--gold:#f2c17b;--edge:clamp(13px,3.2vw,52px);--code:ui-monospace,Consolas,monospace;color-scheme:dark;font:15px/1.45 system-ui,sans-serif}
*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;min-height:100svh;color:var(--ice);background:radial-gradient(ellipse at 62% 0%,#21343e 0,transparent 62%),var(--bg)}button,input{font:inherit}button{color:inherit;cursor:pointer}button:focus-visible,input:focus-visible,summary:focus-visible{outline:2px solid var(--gold);outline-offset:3px}button{touch-action:manipulation}svg{width:21px;height:21px;flex:none;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.sprite{width:0;height:0;position:absolute;overflow:hidden}.wrap{width:min(1220px,calc(100% - 2 * var(--edge)));margin:auto}.mast,.credit{display:flex;align-items:center;justify-content:space-between}.mast{height:clamp(53px,8svh,82px);border-bottom:1px solid var(--hair);margin-bottom:clamp(12px,2svh,24px)}.brand,.slate,.reel,.tag,.stamp,.start,.console,.chap-head,.credit span{display:flex;align-items:center}.brand{gap:11px}.brand svg{width:27px;height:32px;color:var(--gold)}.brand b{font:650 24px/1 Oswald,sans-serif;letter-spacing:.06em}.brand span{border-left:1px solid var(--hair);padding-left:11px;color:var(--dim)}.code,.brand span,.slate,.tag,.stamp,.chap-head,.credit{font:600 10px/1.3 var(--code);letter-spacing:.12em}.slate{gap:10px;color:var(--dim)}.slate i{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 8px #f2c17b77}.slate b{padding:4px 7px;border:1px solid #b68e566e;color:var(--gold);border-radius:2px}
main{width:min(100%,max(660px,calc((100svh - 260px)*16/9)));margin:0 auto}.projector{overflow:hidden;border:1px solid #52616a;border-radius:5px;background:#070c11;box-shadow:0 16px 54px #0006}.screen{position:relative;aspect-ratio:16/9;background:#070b10;overflow:hidden}video{display:block;width:100%;height:100%;object-fit:contain}.enhanced video{cursor:pointer}.cover{position:absolute;inset:0;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:clamp(14px,5%,66px);background:linear-gradient(90deg,#06111bf7,#07121dcc 22%,#07131b36 53%,transparent 78%),linear-gradient(0deg,#07121bb3,transparent 25%,transparent 84%,#07121b78)}.tag{gap:9px;color:var(--gold);font-size:clamp(8px,1vw,12px)}.tag i{width:28px;height:2px;background:currentColor}.cover h1{margin:.18em 0 .14em;font:680 clamp(45px,7.15vw,112px)/.97 Oswald,'Arial Narrow',sans-serif;text-transform:uppercase;letter-spacing:-.025em}.cover h1 em{font-style:normal;color:var(--gold)}.cover p{margin:0;color:#e3edf1;font-size:clamp(12px,1.35vw,19px)}.start{border:1px solid #ffdb9f;background:var(--gold);color:#161c20;font-weight:750;gap:10px;padding:0 17px;min-height:46px;border-radius:3px;margin-top:clamp(12px,2.8vw,31px)}.start small{border-left:1px solid #66523955;padding-left:10px;font:600 11px var(--code)}.start svg{width:16px}.start:hover{background:#ffdaa5}.stamp{position:absolute;bottom:5%;right:4.4%;gap:8px;color:#eaf0f1;text-shadow:0 1px 5px #000;font-size:9px}.stamp b{border:1px solid #e2edf08a;padding:4px 5px}.replay{position:absolute;bottom:7%;right:4%;border:1px solid var(--gold);background:#101a22ec;border-radius:3px;color:var(--gold);min-height:42px;padding:0 14px}.note{margin:0}.note:not(:empty){padding:9px 14px;background:#3b2d20;color:#ffdfb6;font-size:13px}
.console{gap:clamp(4px,1.1vw,13px);padding:4px clamp(6px,1.1vw,16px);min-height:54px;background:linear-gradient(#192630,#111d26);border-top:1px solid #43535b}.icon{width:42px;height:42px;display:grid;place-items:center;border:0;background:transparent;border-radius:3px;flex:none}.icon:hover{background:#ffffff12;color:var(--gold)}.play{color:var(--gold)}.clock{font:550 clamp(10px,1.2vw,13px) var(--code);white-space:nowrap;font-variant-numeric:tabular-nums}.clock i{font-style:normal;color:#8d9faa}.seek{flex:1;min-width:30px;display:flex;align-items:center;padding-inline:3px}input[type=range]{width:100%;height:36px;appearance:none;-webkit-appearance:none;background:transparent;cursor:pointer;margin:0;accent-color:var(--gold)}input[type=range]::-webkit-slider-runnable-track{height:4px;border-radius:4px;background:linear-gradient(to right,var(--gold) var(--at,0%),#475661 var(--at,0%))}input[type=range]::-moz-range-track{height:4px;border-radius:4px;background:#475661}input[type=range]::-moz-range-progress{height:4px;background:var(--gold)}input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:13px;height:13px;background:var(--ice);border:2px solid #d6af74;border-radius:50%;margin-top:-4.5px}input[type=range]::-moz-range-thumb{width:10px;height:10px;border:2px solid #d6af74;border-radius:50%;background:var(--ice)}.chap-head{justify-content:space-between;gap:12px;margin:21px 0 9px;color:var(--dim)}.chap-head b{color:var(--gold)}.chapters{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}.chapters button{text-align:left;min-width:0;min-height:55px;padding:8px 10px;border:none;border-top:2px solid var(--hair);background:#15212b;border-radius:0 0 3px 3px}.chapters button[aria-current=true]{border-color:var(--gold);background:#273037}.chapters button:hover{background:#273540}.chapters time{display:block;font:500 10px var(--code);color:#abbac4}.chapters b{font:550 clamp(12px,1.05vw,16px)/1.5 Oswald,sans-serif;letter-spacing:.02em}.chapters [aria-current=true] time{color:var(--gold)}.credit{min-height:48px;color:#98aeb9;gap:20px;letter-spacing:.05em;font-weight:450}.credit span{gap:9px}details{border-top:1px solid var(--hair);margin:0 0 24px;padding-top:9px;max-width:100%;color:var(--dim)}summary{cursor:pointer;width:fit-content;font-size:13px}details p{max-width:76ch;font-size:14px}.projector:fullscreen,.projector.theatre{background:#070c11;display:flex;flex-direction:column;justify-content:center;border-radius:0;border:0;box-shadow:none}.projector.theatre{position:fixed;inset:0;z-index:20}.projector:fullscreen .screen,.projector.theatre .screen{height:calc(100% - 54px);width:100%;aspect-ratio:auto}.projector:fullscreen .console,.projector.theatre .console{min-height:54px;flex:none}.lock{overflow:hidden}
@media(max-width:740px){main{width:100%}.chapters{grid-template-columns:repeat(4,1fr)}.slate .edition{display:none}.chap-head{margin-top:15px}.cover h1{font-size:clamp(40px,8.9vw,68px)}.stamp{display:none}.start{min-height:40px;font-size:13px;margin-top:12px}.tag i{width:16px}.credit{font-size:9px}.console{gap:3px}.chapters button{min-height:45px}}
@media(max-width:480px) and (orientation:portrait){.wrap{width:calc(100% - 20px)}.mast{height:54px}.brand b{font-size:20px}.brand{gap:7px}.brand svg{width:22px}.code,.slate,.brand span{font-size:9px}.cover{padding:12px 14px}.cover h1{font-size:clamp(32px,9.1vw,45px);margin:6px 0}.cover p{font-size:11px}.tag{font-size:7px;gap:5px}.start{min-height:35px;padding:0 10px;margin-top:8px;gap:6px;font-size:12px}.start small{font-size:9px;padding-left:6px}.console{padding:2px 3px;min-height:45px}.icon{width:36px;height:39px}.clock{font-size:10px}.chapters{grid-template-columns:repeat(3,minmax(0,1fr))}.chapters b{font-size:14px}.credit{min-height:46px;gap:10px}.slate{gap:6px}}
@media(orientation:landscape) and (max-height:550px){.mast{height:38px;margin-bottom:6px}.mast .brand svg{height:26px}.mast .brand b{font-size:19px}main{width:min(100%,calc((100svh - 92px)*16/9))}.cover{padding:3%}.cover h1{font-size:clamp(32px,9svh,48px)}.cover p{font-size:12px}.start{min-height:34px;font-size:12px;margin-top:8px}.console{min-height:42px}.icon{height:34px}.chap-head{margin-top:14px}.stamp{display:none}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
</head>
<body>
<svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
<symbol id="mark" viewBox="0 0 36 38"><path d="m18 1 15 6v15L18 36 3 22V7z"/><path fill="currentColor" stroke="none" d="m9 12 9 4 9-4v4l-9 4-9-4zm0 8 9 4 9-4-9 9z"/></symbol>
<symbol id="p-play" viewBox="0 0 24 24"><path d="m7 4 13 8-13 8z" fill="currentColor" stroke="none"/></symbol><symbol id="p-pause" viewBox="0 0 24 24"><path d="M6 4h4v16H6zm8 0h4v16h-4z" fill="currentColor" stroke="none"/></symbol>
<symbol id="p-sound" viewBox="0 0 24 24"><path d="M3 9h4l5-4v14l-5-4H3zM16 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/></symbol><symbol id="p-mute" viewBox="0 0 24 24"><path d="M3 9h4l5-4v14l-5-4H3zm13 0 6 6m0-6-6 6"/></symbol>
<symbol id="p-full" viewBox="0 0 24 24"><path d="M3 9V3h6m6 0h6v6m0 6v6h-6m-6 0H3v-6"/></symbol><symbol id="p-exit" viewBox="0 0 24 24"><path d="M9 3v6H3m12-6v6h6m0 6h-6v6M3 15h6v6"/></symbol>
</defs></svg>
<div class="wrap">
<header class="mast"><div class="brand"><svg aria-hidden="true"><use href="#mark"/></svg><b>CITY TANKS</b><span>КИНОЗАЛ</span></div><div class="slate"><i aria-hidden="true"></i><span class="edition">ЗИМНИЙ ВЫПУСК</span><b>2026</b></div></header>
<main>
<section id="projector" class="projector" aria-label="Киноплеер: Двойной залп">
<div class="screen"><video id="film" aria-label="CITY TANKS. Северное депо: Двойной залп. Трейлер, 40 секунд" controls playsinline preload="metadata" poster="@POSTER@" src="@MOVIE@">Для просмотра откройте этот HTML в браузере с поддержкой видео MP4.</video>
<div id="cover" class="cover" hidden><div class="tag"><i></i>ЗИМНИЙ ТРЕЙЛЕР&nbsp; / &nbsp;01</div><h1>Двойной<br><em>залп</em></h1><p>Северное депо · CITY TANKS</p><button class="start" id="watch" type="button"><svg aria-hidden="true"><use href="#p-play"/></svg>Смотреть трейлер <small>0:40</small></button><div class="stamp"><b>HD</b> ЛОКАЛЬНЫЙ ПОКАЗ</div></div>
<button type="button" id="replay" class="replay" hidden>↻ Смотреть ещё раз</button></div>
<div class="console" id="desk" role="group" aria-label="Управление трейлером" hidden>
<button type="button" class="icon play" id="play" aria-label="Воспроизвести" title="Воспроизвести (K)"><svg aria-hidden="true"><use href="#p-play"/></svg></button>
<output id="clock" class="clock" aria-live="off">0:00 <i>/ 0:40</i></output>
<label class="seek"><input id="seek" type="range" min="0" max="40" value="0" step="0.1" aria-label="Позиция в трейлере" aria-valuetext="0:00 из 0:40"></label>
<button type="button" class="icon" id="sound" aria-label="Выключить звук" title="Выключить звук (M)"><svg aria-hidden="true"><use href="#p-sound"/></svg></button>
<button type="button" class="icon" id="full" aria-label="На весь экран" title="На весь экран (F)"><svg aria-hidden="true"><use href="#p-full"/></svg></button>
</div><p class="note" id="notice" role="status"></p>
</section>
<nav id="navigation" aria-label="Сцены трейлера" hidden><div class="chap-head"><b>МОНТАЖНЫЙ ЛИСТ</b><span>07 СЦЕН</span></div><div class="chapters" id="chapters"></div></nav>
<footer class="credit"><span>СТУДИЯ СЕВЕРНОГО ДЕПО</span><span>720p &nbsp;/&nbsp; СТЕРЕО</span></footer>
<details><summary>О трейлере · текстовая версия</summary><p>Новогодние огни над депо. В ангаре разворачивается двуствольный СТ-II. Leopard 1 выходит на Песчаный рубеж. В обновлении шесть новых советских веток и четыре немецкие: среди тридцати машин — Объект 277 и Kampfpanzer 67.</p><p>На Ледовой переправе СТ-II выпускает два снаряда одновременно. В этом тренировочном кадре оба попадают: 440 + 440 урона. Затем команда выходит в Грузовой порт. В игре шесть карт и бои с ботами 7×7, 10×10 и 15×15.</p><p>Игровые сцены сняты в CITY TANKS. Музыка и звуковые эффекты созданы для этого ролика. Весь фильм находится в этом файле: для просмотра не нужны игра, интернет или WebGL.</p></details>
<noscript><p>Используйте встроенные кнопки видео для просмотра и перемотки.</p></noscript>
</main></div>
<script>
(()=>{'use strict';
 const $=id=>document.getElementById(id),v=$('film'),box=$('projector'),slider=$('seek');
 const scenes=[[0,'Депо'],[5,'Ангар'],[10,'Leopard 1'],[15,'Две нации'],[20,'Двойной залп'],[27.5,'15 × 15'],[35,'Финал']];
 const fmt=n=>Math.floor(n/60)+':'+String(Math.floor(n%60)).padStart(2,'0');
 const message=s=>{$('notice').textContent=s;};let started=false;
 const duration=()=>Number.isFinite(v.duration) && v.duration>0?v.duration:40;
 function icon(id,key,name,shortcut){const b=$(id);b.querySelector('use').setAttribute('href','#p-'+key);b.setAttribute('aria-label',name);b.title=name+' ('+shortcut+')';}
 function refresh(){const s=Math.max(0,v.currentTime||0),d=duration();slider.max=d;slider.value=s;slider.style.setProperty('--at',(100*s/d)+'%');slider.setAttribute('aria-valuetext',fmt(s)+' из '+fmt(d));$('clock').firstChild.nodeValue=fmt(s)+' ';$('clock').querySelector('i').textContent='/ '+fmt(d);
   const idx=scenes.reduce((q,[at],i)=>s+.001>=at?i:q,0);[...$('chapters').children].forEach((b,i)=>b.setAttribute('aria-current',String(i===idx)));
   $('cover').hidden=started||!!v.error;$('replay').hidden=!v.ended;icon('play',v.paused?'play':'pause',v.ended?'Повторить':v.paused?'Воспроизвести':'Пауза','K');icon('sound',v.muted?'mute':'sound',v.muted?'Включить звук':'Выключить звук','M');}
 async function play(){if(v.error){fail();return;}if(v.ended)v.currentTime=0;const from=$('cover').contains(document.activeElement)||document.activeElement===$('replay');try{await v.play();started=true;message('');refresh();if(from)$('play').focus({preventScroll:true});}catch(e){if(e.name!=='AbortError')message('Не удалось начать воспроизведение. Нажмите ▶ или откройте файл в другом браузере.');}}
 function toggle(){if(v.paused||v.ended)play();else v.pause();}
 function jump(s){started=true;v.currentTime=Math.max(0,Math.min(duration(),s));refresh();}
 const visibleFull=()=>!!(document.fullscreenElement||box.classList.contains('theatre'));
 function syncFull(){const on=visibleFull();icon('full',on?'exit':'full',on?'Свернуть экран':'На весь экран','F');}
 async function full(){if(document.fullscreenElement){await document.exitFullscreen();return;}
   if(box.classList.contains('theatre')){box.classList.remove('theatre');document.body.classList.remove('lock');syncFull();return;}
   try{await box.requestFullscreen();}catch{box.classList.add('theatre');document.body.classList.add('lock');}syncFull();}
 function fail(){v.controls=true;$('desk').hidden=$('cover').hidden=$('replay').hidden=$('navigation').hidden=true;message('Браузер не смог открыть встроенное видео H.264/AAC. Распакуйте архив и откройте index.html в современном браузере.');}
 for(const [i,[at,title]] of scenes.entries()){const b=document.createElement('button'),t=document.createElement('time'),n=document.createElement('b');b.type='button';t.dateTime='PT'+at+'S';t.textContent=fmt(at)+(at%1?',5':'');n.textContent=title;b.append(t,n);b.setAttribute('aria-label','Сцена '+(i+1)+': '+title+', '+t.textContent);b.onclick=()=>{jump(at);play();};$('chapters').append(b);}
 $('watch').onclick=$('replay').onclick=play;$('play').onclick=toggle;v.onclick=toggle;$('sound').onclick=()=>{v.muted=!v.muted;refresh();};$('full').onclick=full;slider.oninput=()=>jump(Number(slider.value));
 for(const ev of ['timeupdate','durationchange','loadedmetadata','pause','ended','seeked','volumechange'])v.addEventListener(ev,refresh);
 v.addEventListener('playing',()=>{started=true;refresh();});v.addEventListener('error',fail);document.addEventListener('fullscreenchange',syncFull);
 document.addEventListener('keydown',e=>{if(e.defaultPrevented||e.altKey||e.ctrlKey||e.metaKey)return;if(e.key==='Escape' && box.classList.contains('theatre')){full();return;}if(e.target.closest('button,input,summary')&&[' ','Enter','ArrowLeft','ArrowRight'].includes(e.key))return;
   switch(e.key.toLowerCase()){case ' ':case 'k':toggle();break;case 'm':$('sound').click();break;case 'f':full();break;case 'arrowleft':jump(v.currentTime-5);break;case 'arrowright':jump(v.currentTime+5);break;default:return;}e.preventDefault();});
 if(v.error){fail();return;}v.controls=false;box.classList.add('enhanced');$('desk').hidden=$('navigation').hidden=false;refresh();
})();
</script>
<!-- Embedded display typeface: Oswald. License follows; it applies to the font, not the film. -->
<script type="text/plain" id="font-license">@FONTLICENSE@</script>
</body></html>
